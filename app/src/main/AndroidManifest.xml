<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml – centralna konfiguracijska datoteka svake Android aplikacije.
    Android OS čita ovaj fajl pre pokretanja da bi znao:
      - koje aktivnosti postoje u aplikaciji
      - koja aktivnost se prva otvara (launcher)
      - koja je ikonica i naziv aplikacije
      - koje su dozvole i pravila backup-a
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        xmlns:android – standardni XML namespace; svi android: atributi potiču odavde
        xmlns:tools   – namespace za alate koji ne utiče na ponašanje aplikacije u radu
    -->

    <!--
        <application> – opisuje celu aplikaciju: ikonicu, naziv, temu i pravila backup-a.
        Sve aktivnosti i servisi moraju biti deklarirani unutar ovog bloka.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseLite">
        <!--
            allowBackup="true"                     – dozvoljava Android sistemu da pravi backup podataka aplikacije
            dataExtractionRules="@xml/..."         – fajl koji određuje šta se kopira pri backup-u (Android 12+)
            fullBackupContent="@xml/backup_rules"  – pravila backup-a za starije verzije Androida
            icon="@mipmap/ic_launcher"             – ikonica aplikacije na početnom ekranu uređaja
            label="@string/app_name"               – naziv aplikacije koji se vidi u listi aplikacija
            roundIcon="@mipmap/ic_launcher_round"  – okrugla ikonica za uređaje koji je zahtevaju
            supportsRtl="true"                     – podrška za jezike koji se pišu s desna na levo
            theme="@style/Theme.ExpenseLite"       – vizuelni stil (boje, fontovi) primenjen na celu aplikaciju
        -->

        <!--
            MainActivity – prvi ekran koji se prikazuje pri pokretanju aplikacije.
            exported="true" je neophodno kako bi Android sistem mogao da je pokrene.
            intent-filter sa MAIN + LAUNCHER kaže Androidu da je ovo ulazna tačka
            i da aktivnost treba prikazati u listi aplikacija na uređaju.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <!-- MAIN: ova aktivnost je ulazna tačka aplikacije -->
                <action android:name="android.intent.action.MAIN" />
                <!-- LAUNCHER: prikazuje se u listi instaliranih aplikacija na uređaju -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            AddExpenseActivity – ekran za unos novog troška.
            exported="false" – ne može je pokrenuti neka druga aplikacija, samo naša.
            parentActivityName – definiše roditeljsku aktivnost radi navigacije (strelica ← u toolbaru).
        -->
        <activity
            android:name=".AddExpenseActivity"
            android:parentActivityName=".MainActivity"
            android:exported="false" />

    </application>

</manifest>
